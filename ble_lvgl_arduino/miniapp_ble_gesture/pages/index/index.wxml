<!--pages/index/index.wxml-->
<view class="page">
  <!-- 顶部大标题 -->
  <view class="header">
    <view class="title">蓝牙手势控制</view>
    <view class="subtitle">扫描并连接 ESP32 设备</view>
  </view>

  <!-- 状态提示 -->
  <view class="status-bar {{scanning ? 'scanning' : ''}}">
    <view wx:if="{{scanning}}" class="status-dot status-dot-blue"></view>
    <view wx:else class="status-dot status-dot-gray"></view>
    <text class="status-text">
      {{scanning ? '正在扫描设备…' : (deviceList.length > 0 ? '已发现 ' + deviceList.length + ' 台设备' : '点击下方按钮开始扫描')}}
    </text>
  </view>

  <!-- 扫描按钮 -->
  <view class="scan-btn-wrap">
    <button
      class="btn {{scanning ? 'btn-gray' : 'btn-blue'}}"
      bindtap="onScanTap"
      loading="{{scanning}}">
      {{scanning ? '停止扫描' : '开始扫描'}}
    </button>
  </view>

  <!-- 设备列表 -->
  <view class="list-title">可用设备</view>
  <scroll-view class="device-list" scroll-y="{{true}}">
    <block wx:if="{{deviceList.length === 0}}">
      <view class="empty-tip">
        <image class="empty-icon" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 24 24' fill='none' stroke='%23C7C7CC' stroke-width='1.5'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>" />
        <text class="empty-text">暂未发现设备</text>
        <text class="empty-sub">请确保 ESP32 已上电且蓝牙广播正常</text>
      </view>
    </block>
    <block wx:for="{{deviceList}}" wx:key="deviceId">
      <view
        class="device-item {{selectedIndex === index ? 'selected' : ''}}"
        bindtap="onDeviceTap"
        data-index="{{index}}">
        <view class="device-left">
          <view class="device-icon">
            <!-- 蓝牙小图标 -->
            <image class="icon" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='%23007AFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6.5 6.5L17.5 17.5L12 23V1L17.5 6.5L6.5 17.5'/></svg>" />
          </view>
          <view class="device-info">
            <view class="device-name">{{item.name || '未知设备'}}</view>
            <view class="device-mac">MAC: {{item.deviceId}}</view>
          </view>
        </view>
        <view class="device-right">
          <!-- RSSI 信号格 -->
          <view class="rssi-bar">
            <view class="bar {{item.RSSI >= -55 ? 'on' : ''}}"></view>
            <view class="bar {{item.RSSI >= -70 ? 'on' : ''}}"></view>
            <view class="bar {{item.RSSI >= -85 ? 'on' : ''}}"></view>
            <view class="bar {{item.RSSI >= -100 ? 'on' : ''}}"></view>
          </view>
          <view class="rssi-text">{{item.RSSI}} dBm</view>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 底部连接按钮 -->
  <view class="connect-wrap">
    <button
      class="btn btn-connect {{selectedIndex >= 0 ? 'btn-blue' : 'btn-disabled'}}"
      disabled="{{selectedIndex < 0 || connecting}}"
      bindtap="onConnectTap"
      loading="{{connecting}}">
      {{connecting ? '连接中…' : (selectedIndex >= 0 ? '连接 ' + deviceList[selectedIndex].name : '请先选择设备')}}
    </button>
  </view>
</view>
